# M0 server settings. Copy to .env for local development if overrides are needed.
APP_NAME=Shiguang API
APP_VERSION=0.1.0
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite+aiosqlite:///./data/shiguang.db
LOG_LEVEL=INFO

# Optional real model provider. Keep disabled and blank until explicitly authorized.
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=30

# Optional offline cost-estimation rates for MODEL_NAME. Decimal cost per 1M tokens.
MODEL_INPUT_PRICE_PER_MILLION_TOKENS=
MODEL_OUTPUT_PRICE_PER_MILLION_TOKENS=
MODEL_COST_CURRENCY=CNY
MODEL_PRICING_SOURCE=configured_model_rates

# Hard run safety ceilings. Values may be lowered, never raised above 8 calls / 60 seconds.
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=60
RUN_REAL_MODEL_TESTS=0

# Optional real Amap Web Service provider. The base origin is fixed; keep the key blank until
# separately authorized.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=5
AMAP_MAX_RETRIES=1
AMAP_RETRY_AFTER_MAX_SECONDS=1
RUN_REAL_MAP_TESTS=0

# Provider-neutral POI matching thresholds. All are finite in (0, 100]; candidate
# score cannot exceed unique score. Search rank is never a success threshold.
PLACE_MATCH_UNIQUE_SCORE=75
PLACE_MATCH_MINIMUM_SCORE_GAP=12
PLACE_MATCH_CANDIDATE_SCORE=35
