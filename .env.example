# M0-0B server settings. Copy to .env for local development if overrides are needed.
APP_NAME=Shiguang API
APP_VERSION=0.1.0
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite+aiosqlite:///./data/shiguang.db
LOG_LEVEL=INFO

# Optional real model provider. Keep disabled and blank until explicitly authorized.
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=30
RUN_REAL_MODEL_TESTS=0
