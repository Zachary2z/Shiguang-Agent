# M1 server-only settings. Copy to .env at the repository root when overrides
# are needed. Never rename secrets to NEXT_PUBLIC_* or put them in frontend env files.
APP_NAME=Shiguang API
APP_VERSION=0.1.0
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+asyncpg://shiguang:change-me@postgres:5432/shiguang
DEMO_DATABASE_URL=postgresql+asyncpg://shiguang:change-me@demo-postgres:5432/shiguang_demo
DEMO_ENABLED=1
WEB_SESSION_COOKIE_SECURE=0
REAL_WEB_SESSION_TTL_SECONDS=2592000
DEMO_WEB_SESSION_TTL_SECONDS=7200
LOG_LEVEL=INFO

# Optional real model provider. Uncomment all three lines together when enabling it.
# Commented optional values remain unconfigured in both API and Worker.
# MODEL_API_BASE=
# MODEL_API_KEY=
# MODEL_NAME=
# Abnormal Provider/transport safety cap; the rich-input workflow cancels first at 60 seconds.
MODEL_TIMEOUT_SECONDS=75
MODEL_STRUCTURED_OUTPUT_MODE=none

# Optional offline cost-estimation rates for MODEL_NAME. Decimal cost per 1M tokens.
# MODEL_INPUT_PRICE_PER_MILLION_TOKENS=
# MODEL_OUTPUT_PRICE_PER_MILLION_TOKENS=
MODEL_COST_CURRENCY=CNY
MODEL_PRICING_SOURCE=configured_model_rates

# Hard run safety ceilings. Values may be lowered, never raised above 8 calls / 60 seconds.
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=1
RUN_REAL_MODEL_TESTS=0

# Optional real Amap Web Service provider. Compose passes the same settings to API and Worker;
# keep the key blank until separately authorized.
# AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=5
AMAP_MAX_RETRIES=1
AMAP_RETRY_AFTER_MAX_SECONDS=1
RUN_REAL_MAP_TESTS=0

# RUN_REAL_MODEL_TESTS and RUN_REAL_MAP_TESTS only gate pytest real-provider
# tests. They do not enable or disable providers during normal product use.

# Provider-neutral POI matching thresholds. All are finite in (0, 100]; candidate
# score cannot exceed unique score. Search rank is never a success threshold.
PLACE_MATCH_UNIQUE_SCORE=75
PLACE_MATCH_MINIMUM_SCORE_GAP=12
PLACE_MATCH_CANDIDATE_SCORE=35

# Local private storage only. The root must remain outside public/static directories.
STORAGE_PRIVATE_ROOT=./data/private
DEMO_STORAGE_PRIVATE_ROOT=./data/demo-private
STORAGE_MAX_FILE_SIZE_BYTES=10000000
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
